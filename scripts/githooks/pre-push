#!/usr/bin/env bash
# pre-push — the fast half of ./test/run.sh gates, for the one property no clone can check.
#
# Why this exists: test/verify-mirror-live.sh compares the mirror against the live copy on
# *this* machine. A fresh clone has no live directory, so the container suites cannot run it
# and a green gate says nothing about it — that direction is structurally outside the gates.
# At push time the question is exactly the right one and has an answer: is the snapshot I am
# publishing the machine I am publishing from?
#
# Scope is the fast invariants only:
#   test/verify-revert-detection.sh   builds the three direction cases in throwaway repos (~2s)
#   test/verify-mirror-live.sh        compares mirror to live; prints `skip:` where there is none (~1s)
# The round-trip gate clones fifteen repositories and belongs to the full run, not to every push.
#
# Escape: `git push --no-verify` for a lane with a real reason. Prefer fixing what it reports;
# a hook that fails wrongly blocks every lane pushing from every worktree of this repository.
set -uo pipefail

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo" || exit 0

# Scope. These gates protect *this* repository, and the hook lives inside it — so if the hook
# file being executed is not inside the repository being pushed, the push is publishing some
# other repository and these gates do not describe it. Measured 2026-11-26: run from a throwaway
# `git init` directory, this hook failed with "test/verify-revert-detection.sh is missing, so
# this push is not checked" — correct logic, applied to the wrong repository, reported as a
# failure to push content that never had those gates.
#
# This does NOT weaken the missing-script FAIL below. When the push is from this repository,
# core.hooksPath is the relative `scripts/githooks`, so the hook file necessarily resolves
# inside $repo and the FAIL still fires. The skip can only be reached when the hook is running
# outside the repository whose gates it lists, which is exactly when they do not apply.
self_path="$(realpath -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
case "$self_path" in
  "$repo"/*) ;;
  *)
    echo "pre-push: skip: this hook is $self_path, outside the repository being pushed ($repo) — its gates do not apply here" >&2
    exit 0
    ;;
esac

# Destination. $2 is the URL git is pushing to. The gates below compare this machine's mirror
# against the live copy — a property of THIS repository — so they cannot describe a push that
# publishes something else (a subrepo's upstream, a mirror). Measured 2026-11-26 (overlord, at the
# source): the hook read no destination at all, so a push of unrelated content ran these gates
# anyway and was judged by them.
#
# The location check above catches a hook running outside this repository; this one catches a push
# made FROM this tree TO somewhere else, which is the subrepo case. Both must hold to run the gates.
dest="${2:-}"
if [ -n "$dest" ]; then
  own=0
  for _url in $(git remote -v | awk '{print $2}' | sort -u); do
    [ -n "$_url" ] || continue
    if [ "$_url" = "$dest" ]; then own=1; break; fi
    # an unconfigured URL naming this same repository is still this repository
    case "$dest" in
      *"/$(basename "$_url" .git)") own=1; break ;;
    esac
  done
  if [ "$own" != 1 ]; then
    echo "pre-push: skip: destination $dest is not a remote of this repository ($repo) — these gates describe this repository only" >&2
    exit 0
  fi
fi

rc=0
for t in test/verify-revert-detection.sh test/verify-mirror-live.sh; do
  # A missing check must FAIL, not `continue`. `[ -f "$t" ] || continue` reads as
  # defensive and is the opposite: rename or delete the script and the hook keeps
  # exiting 0, so the control silently stops existing while its file list still
  # reads as coverage. Verifying nothing is not the same as verifying successfully.
  if [ ! -f "$t" ]; then
    echo "pre-push: FAILED — $t is missing, so this push is not checked. Restore it or" >&2
    echo "          remove it from this hook's list in the same change that removes the gate." >&2
    rc=1
    continue
  fi
  printf 'pre-push: %s\n' "$t" >&2
  bash "$t" || rc=1
done

if [ "$rc" != 0 ]; then
  echo "pre-push: FAILED — nothing was pushed. Fix the finding above, or use --no-verify with a reason." >&2
fi
exit "$rc"
