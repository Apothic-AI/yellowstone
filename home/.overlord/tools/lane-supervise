#!/usr/bin/env python3
"""lane-supervise — keep leader lanes up, without the overlord lane doing it by hand.

History, because it explains every guard here
---------------------------------------------
`overlord-watchdog.sh` (unit `overlord-watchdog.timer`, every minute) resumed ONE lane, the
overlord on `wE:p1`, and its invariants were learned from the 2026-11-02 `pkill -f 'pi$'` that
killed ~46 lanes while the operator was away:

  * never resume over a live lane — a resumed lane that was merely slow means two writers on one
    session, which is a second outage, not a fix;
  * resume, never start fresh — the coordination state lives in the session, so a blank session is
    an outage with a healthy pid;
  * record the session UUID, not the path — pi-profile-switch makes a new instance dir per launch
    and sweeps old ones, so a recorded path can be gone by the next pass;
  * never overwrite a good target with a path whose file does not exist yet.

Staying-up was then a job the *overlord lane* did by reading its board, which meant a killed lane
waited for the next round (or for the operator to notice, as happened on 2026-11-14 to
self-improvement-leader). This tool moves that job to a timer: every LEADER lane is covered
automatically, and a new space's leader is picked up without editing any unit.

How a lane is discovered
------------------------
Roles, not live state: `~/.local/state/pil/roles/<lane>.env` is written by `pil` at launch and
carries `PI_MODE=leader|worker`. A leader lane is therefore discoverable **while it is down**, which
is the only moment supervision matters. The live read (`herdr agent get`) is used to refresh pane,
cwd and session UUID while the lane is up; those are persisted per lane, so a resume needs no live
information.

  * every role record with `PI_MODE=leader`            -> supervised automatically
  * `--add <lane>` (any role)                          -> supervised because you asked
  * `--exclude <lane>`                                 -> never touched, for holds
  * `~/.local/state/pil/supervise/<lane>.json`         -> last known pane/cwd/session, refreshed live

A **worker** lane is not supervised unless it is added. That is a decision, not an oversight: worker
lanes are per-item and are retired when their item is done, so resuming every one of them would
resurrect finished work (measured 2026-11-17: 39 leader role records, 189 worker role records, 168
of them already inactive). What was an oversight is that `--list` printed only the lanes it covered,
so the operator saw 20 lanes and concluded the fleet was covered while 20 more were live and outside
it (FT-78: a worker named `experiment` was Ctrl-C'd and never came back, and nothing said why). The
boundary is now printed, and `--add` seeds pane/session/role from the lane's own record so it also
works after the lane is already down.

Usage
-----
  lane-supervise                      one pass (this is what the timer runs)
  lane-supervise --dry-run            report what would happen; never launch, never write
  lane-supervise --list [--json]      discovered lanes, their state, and why each is included
  lane-supervise --list --uncovered   also list every role record this pass will NOT resume
  lane-supervise --add <lane>         also supervise a non-leader lane (seeds its pane/session/role
                                      from ~/.local/state/pil/sessions/<lane>.json when it is down)
  lane-supervise --remove <lane>      drop an --add, and the state that kept it discovered
  lane-supervise --exclude <lane>     never supervise this lane (holds, deliberately-down lanes)
  lane-supervise --unexclude <lane>
  lane-supervise --only <lane>        restrict a pass to one lane

Guards
------
  * a lane with a live pi process in its pane is left alone and its state is refreshed
  * a lane with no recorded session id is NOT started fresh; it is reported and retried slowly
  * a lane with no persisted pane is reported as needing a human (it must be started once, alive)
  * the pass takes the same flock the watchdog used, so two supervisors can never race one lane
  * backoff: 60s, doubling, capped at 30 min — a bundle that cannot start must not become a loop
  * the resumed lane is told it was resumed by a machine, with the timestamp, so it can reason
    about the gap instead of silently continuing

Exit codes: 0 nothing needed doing or everything resumed · 1 something failed or needs a human ·
2 refusal before reading anything.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "pil")
SUPERVISE = os.path.join(STATE, "supervise")
ROLES = os.path.join(STATE, "roles")
SESSIONS = os.path.join(STATE, "sessions")
LOCK = os.path.join(os.path.dirname(STATE), "overlord", "watchdog.lock")
EXCLUDE_FILE = os.path.join(SUPERVISE, "_exclude.json")
EXTRA_FILE = os.path.join(SUPERVISE, "_extra.json")
BACKOFF_BASE = 60.0
BACKOFF_CAP = 1800.0
# A lane that dies again inside this window is flapping, not recovering: its backoff must keep
# growing instead of restarting at 60s. Each restart reloads the whole session file (111 MB here,
# ~1.4-2 GB resident), which is the last thing an already-swapping box needs.
FLAP_WINDOW = 600.0
FLAP_HUMAN_AT = 5


def out(msg: str) -> None:
    print(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}")


def die(msg: str, code: int = 2) -> "None":
    print(f"lane-supervise: {msg}", file=sys.stderr)
    raise SystemExit(code)


def herdr(*args: str) -> dict:
    try:
        proc = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    if proc.returncode != 0:
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


def agent(lane: str) -> dict:
    return (herdr("agent", "get", lane).get("result") or {}).get("agent") or {}


def read_json(path: str, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path: str, data) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, path)


def exclusions() -> set[str]:
    data = read_json(EXCLUDE_FILE, [])
    return set(data if isinstance(data, list) else [])


def extras() -> set[str]:
    data = read_json(EXTRA_FILE, [])
    return set(data if isinstance(data, list) else [])


def role_records() -> dict[str, str]:
    """lane -> PI_MODE, from the role file pil writes at launch. Survives the lane being down."""
    found: dict[str, str] = {}
    try:
        names = os.listdir(ROLES)
    except OSError:
        return found
    for name in names:
        if not name.endswith(".env"):
            continue
        lane = name[:-4]
        try:
            with open(os.path.join(ROLES, name), encoding="utf-8") as fh:
                mode = ""
                for token in fh.read().split():
                    if token.startswith("PI_MODE="):
                        mode = token.split("=", 1)[1]
                        break
        except OSError:
            continue
        if mode:
            found[lane] = mode
    return found


def role_of(lane: str) -> str:
    """This lane's role from its own record, "" when there is none.

    The resume command is `pil --role <role>`, so the role has to come from the record rather than
    from a default: defaulting to leader is how a worker lane gets promoted by a repair (measured
    2026-11-13 on `ft55-parameter-plan`).
    """
    return role_records().get(lane, "")


def lane_record(lane: str) -> dict:
    """The lane's own record from pi's state-change extension: pane, tab, session, cwd, pid.

    `~/.local/state/pil/sessions/<lane>.json` is written by every live lane, workers included, and
    it is the only record that still says where a lane lived after its process is gone. A resume
    needs three facts from it (pane, session id, cwd) plus the role, so an `--add` issued after the
    lane has already died can still produce a correct `pil --role worker --session <id>`.
    """
    rec = read_json(os.path.join(SESSIONS, f"{lane}.json"), {})
    return rec if isinstance(rec, dict) else {}


def seed_state(lane: str) -> dict:
    """Write the state a down lane needs to be resume-able, from records that outlive it.

    Returns the state written, {} when there is nothing new to write. A state file that already
    names pane and session is left alone: it was refreshed from the lane itself, so it is better
    evidence than a record of where the lane used to be.
    """
    st = read_json(state_path(lane), {}) or {}
    if not isinstance(st, dict):
        st = {}
    if st.get("session_id") and st.get("pane"):
        return {}
    rec = lane_record(lane)
    new = dict(st)
    sess = rec.get("session") or ""
    sid = session_id(sess) if sess else ""
    if sid and not new.get("session_id"):
        new["session_id"] = sid
        new["session_path"] = sess
    if rec.get("paneId") and not new.get("pane"):
        new["pane"] = rec.get("paneId")
    if not new.get("cwd"):
        # The lane record often has no cwd (the extension records pane and session, not the working
        # directory), and resuming in $HOME is its own defect: a space lane resumed outside its
        # space loads a different AGENTS.md and a different mode. herdr still knows the pane's cwd,
        # so ask it while the pane is still there.
        cwd = rec.get("cwd") or pane_cwd(new.get("pane") or "")
        if cwd:
            new["cwd"] = cwd
    roles = role_of(lane)
    if roles and not new.get("role"):
        new["role"] = roles
    if not new.get("lane"):
        new["lane"] = lane
    if new == st:
        return {}
    new["seeded_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    new["seeded_from"] = os.path.join(SESSIONS, f"{lane}.json")
    write_json(state_path(lane), new)
    return new


def uncovered(supervised: dict[str, str], excluded: set[str]) -> list[dict]:
    """Role-record lanes this pass will NOT resume, with the reason and what is known about them.

    An absence has to be printed as an absence: the pass has no record to write for a lane it never
    considers, so this is the only place the operator can learn that a live lane is unwatched.
    """
    roles = role_records()
    alive = live_agents()
    rows = []
    # A live lane with no role record is invisible to every pass by construction: discovery reads
    # role records. It is also the one case where "not supervised" was pure silence.
    for lane, pane in sorted(alive.items()):
        if lane in supervised or lane in roles:
            continue
        rows.append({
            "lane": lane,
            "mode": None,
            "alive": True,
            "pane": pane or None,
            "session_id": session_id((lane_record(lane).get("session") or "")) or None,
            "reason": "no role record — discovery reads role records, so no pass sees it",
        })
    for lane, mode in sorted(roles.items()):
        if lane in supervised:
            continue
        rec = lane_record(lane)
        if lane in excluded:
            reason = "excluded (never touched)"
        elif mode != "leader":
            reason = f"{mode or 'no mode'} role record — not supervised unless --add"
        elif lane in alive:
            reason = "leader, alive, not yet observed by a pass"
        else:
            reason = "leader never observed alive — a retired space, not resumed"
        rows.append({
            "lane": lane,
            "mode": mode or None,
            "alive": lane in alive,
            "pane": rec.get("paneId") or None,
            "session_id": session_id(rec.get("session") or "") or None,
            "reason": reason,
        })
    return rows


def live_agents() -> dict[str, str]:
    """lane -> pane id for every agent herdr knows about right now.

    A dict rather than a set because the only lanes an operator cannot otherwise see are the ones
    with no role record, and naming those means naming their pane too.
    """
    data = herdr("agent", "list").get("result", {}) or {}
    found: dict[str, str] = {}
    for rec in data.get("agents") or []:
        name = rec.get("name") or ""
        if name:
            found[name] = rec.get("pane_id") or ""
    return found


def pane_cwd(pane: str) -> str:
    """A pane's working directory, as herdr reports it — including for a lane that is down."""
    if not pane:
        return ""
    panes = (herdr("pane", "list").get("result") or {}).get("panes") or []
    for rec in panes:
        if rec.get("pane_id") == pane:
            return rec.get("cwd") or ""
    return ""


def occupant(pane: str) -> str:
    """The lane herdr says is in this pane, "" when it says nothing.

    A pane is a shared surface, so "there is a pi in the recorded pane" is not "this lane is up":
    the tab may have been closed and reopened for another lane, or the lane replaced in place. The
    pass used the pi alone, which made a foreign lane look like this one — it would refresh the
    down lane's state to point at someone else's pane, and never resume it, silently.
    """
    if not pane:
        return ""
    for lane, where in live_agents().items():
        if where == pane:
            return lane
    return ""


def lanes_with_state() -> set[str]:
    try:
        names = os.listdir(SUPERVISE)
    except OSError:
        return set()
    return {n[:-5] for n in names if n.endswith(".json") and not n.startswith("_")}


def discovery() -> tuple[dict[str, str], set[str]]:
    """Return (lane -> reason, excluded) for what this pass would consider.

    A lane is supervised only once it has been OBSERVED: either it is alive now with a leader
    role record, or a previous pass persisted its pane and session. That scoping keeps retired
    spaces out - herdr-leader, mycord-leader, palette-probe and friends still have role records
    on disk from spaces that no longer exist, and resurrecting them is not recovery, it is
    archaeology.
    """
    excluded = exclusions()
    roles = role_records()
    alive = live_agents()
    lanes: dict[str, str] = {}
    for lane, mode in roles.items():
        if mode == "leader" and lane in alive:
            lanes[lane] = "leader, alive"
    # Extras before observations: a lane somebody added on purpose should be reported as added, not
    # as "observed earlier", or the one line that explains why it is covered is the one that lies.
    for lane in extras():
        lanes.setdefault(lane, "added explicitly")
    for lane in lanes_with_state():
        lanes.setdefault(lane, "observed earlier")
    for lane in excluded:
        lanes.pop(lane, None)
    return lanes, excluded


def state_path(lane: str) -> str:
    return os.path.join(SUPERVISE, f"{lane}.json")


def session_of(rec: dict) -> str | None:
    sess = rec.get("agent_session") or {}
    path = sess.get("value") if isinstance(sess, dict) else None
    return path if path and os.path.exists(path) else None


def session_id(path: str) -> str:
    base = os.path.basename(path)
    if "_" in base:
        base = base.split("_", 1)[1]
    return base[:-6] if base.endswith(".jsonl") else ""


def pi_pid(pane: str) -> str | None:
    if not pane:
        return None
    procs = ((herdr("pane", "process-info", "--pane", pane).get("result") or {})
             .get("process_info") or {}).get("foreground_processes") or []
    for proc in procs:
        if (proc.get("name") or "") == "pi" or (proc.get("argv") or [None])[0] == "pi":
            return str(proc.get("pid") or "")
    return None


def down_evidence(pane: str, lane: str) -> str:
    """What the pane actually looked like when supervision called the lane down.

    Several times this lane was declared DOWN and the cause was reconstructed afterwards by hand --
    once wrongly, from a startup race that turned out to last 1.5s. The journal should carry the
    observation, not a hypothesis about it: the foreground processes (names and pids), the agent
    status herdr reports, and the memory the box had left at that moment.
    """
    parts = []
    try:
        info = ((herdr("pane", "process-info", "--pane", pane).get("result") or {})
                .get("process_info") or {})
        procs = info.get("foreground_processes") or []
        parts.append("foreground=[" + (", ".join(
            f"{(p.get('name') or '?')}:{p.get('pid')}" for p in procs) or "EMPTY") + "]")
    except Exception as exc:  # noqa: BLE001 - evidence must never break supervision
        parts.append(f"process-info-failed={exc}")
    try:
        parts.append(f"agent_status={agent(lane).get('agent_status')}")
    except Exception:  # noqa: BLE001
        parts.append("agent_status=?")
    try:
        with open("/proc/meminfo") as fh:
            mem = {}
            for line in fh:
                key = line.split(":", 1)[0]
                if key in ("MemAvailable", "SwapFree", "SwapTotal"):
                    mem[key] = line.split()[1]
        if mem:
            parts.append("meminfo=" + ",".join(f"{k}={v}kB" for k, v in mem.items()))
    except OSError:
        pass
    return " ".join(parts)


def refresh(lane: str, st: dict, rec: dict) -> dict:
    """Update the persisted state from a live lane."""
    sess = session_of(rec)
    st = dict(st)
    st.update({
        "lane": lane,
        "pane": rec.get("pane_id") or st.get("pane"),
        "cwd": rec.get("cwd") or st.get("cwd"),
        "status": rec.get("agent_status") or st.get("status"),
        "refreshed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    })
    # Carry the role, so a state file cannot outlive its lane's role and get resumed as a leader.
    role = role_of(lane)
    if role:
        st["role"] = role
    if sess:
        st["session_id"] = session_id(sess)
        st["session_path"] = sess
    return st


def shquote(text: str) -> str:
    return "'" + text.replace("'", "'\\''") + "'"


def deliver(lane: str, msg: str, marker: str, attempts: int = 6) -> bool:
    """Type the message and keep pressing until the lane's session records it.

    herdr's exit status is not evidence of submission. A prompt typed while pi is still attaching
    is left in the composer with the Enter swallowed — the pty is not reading yet — and herdr
    reports exactly that as `agent_prompt_stalled`. Measured twice: 2026-11-16 (the operator found
    the notice unsubmitted hours later) and 2026-11-17T07:00:14Z (the notice sat in the composer
    until the operator pressed Enter).

    The first revision checked the session after a *successful* prompt, and returned early on a
    failure — so the recovery was unreachable for the one failure that leaves text in the composer.
    The status is therefore used only to learn whether the text got typed at all; whether the lane
    knows is judged from the session, which is the only artifact that cannot lie about it.
    """
    proc = subprocess.run(["herdr", "agent", "prompt", lane, msg, "--wait", "--timeout", "30000"],
                          capture_output=True, text=True)
    detail = (proc.stderr or proc.stdout or "").strip()
    typed = proc.returncode == 0 or "agent_prompt_stalled" in detail
    if not typed:
        # Nothing was typed at all: let the lane settle and make one full attempt more.
        time.sleep(3)
        proc = subprocess.run(["herdr", "agent", "prompt", lane, msg, "--wait", "--timeout", "30000"],
                              capture_output=True, text=True)
        detail = (proc.stderr or proc.stdout or "").strip()
        typed = proc.returncode == 0 or "agent_prompt_stalled" in detail
    for attempt in range(attempts):
        if notice_recorded(lane, marker, wait=4.0):
            suffix = "" if attempt == 0 else f" (submitted on attempt {attempt + 1})"
            out(f"{lane}: told the lane it was resumed{suffix}")
            return True
        if typed:
            # The text is in the composer; Enter is what it still needs.
            herdr("agent", "send-keys", lane, "enter")
        time.sleep(2)
    out(f"{lane}: resume notice TYPED BUT NOT SUBMITTED after {attempts} attempts — it is sitting in "
        f"the composer and needs a human ({detail[:100]})")
    return False


def notify(lane: str) -> bool:
    """Tell a resumed lane it was resumed. False means it does not know, and a human should look."""
    resumed_at = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    msg = (f"[lane-supervise — automated resume, NOT from the operator] This lane was found down and "
           f"resumed into its previous session at {resumed_at}. "
           f"Nothing was restarted; whatever was in flight is still in this session. Check the gap.")
    rec = agent(lane)
    if rec.get("agent_status") in ("working", "blocked"):
        out(f"{lane}: back but {rec.get('agent_status')} — not interrupting with the notice")
        return True
    return deliver(lane, msg, resumed_at)


def notice_recorded(lane: str, marker: str, wait: float = 8.0) -> bool:
    """True when the lane's session records a *user message* containing `marker`.

    Screen-reading cannot answer this: the notice text also appears in the transcript once sent,
    and transcript rows use the same box border as the composer, so a border test both
    false-positives and false-negatives. Grepping the raw tail does not work either — the lane's
    own tool output echoes the marker (measured: a marker that never existed matched because this
    very function's argument was in the file). So parse the tail as JSONL and accept only
    `role: "user"` records. `marker` carries the resume timestamp, so it is unique per notice.
    """
    rec = agent(lane)
    path = ((rec.get("agent_session") or {}).get("value")) or ""
    if not path or not os.path.exists(path):
        return False
    deadline = time.time() + wait
    while True:
        try:
            with open(path, "rb") as fh:
                fh.seek(max(0, os.path.getsize(path) - 600_000))
                tail = fh.read().decode("utf-8", "ignore")
        except OSError:
            return False
        for line in tail.splitlines():
            if marker not in line:
                continue
            try:
                rec_json = json.loads(line)
            except Exception:
                continue
            msg = rec_json.get("message") or {}
            if msg.get("role") != "user":
                continue
            content = msg.get("content")
            text = content if isinstance(content, str) else json.dumps(content)
            if marker in text:
                return True
        if time.time() >= deadline:
            return False
        time.sleep(1.0)


def behold_still_sees(lane: str) -> bool | None:
    """Second opinion before a resume: True if behold still lists the lane, None if it cannot say.

    behold publishes an explicit negative (`lane-not-found`, exit 5), which is the only direction
    worth trusting here: a lane it still lists means herdr lagged, so resuming would race. Any
    other failure returns None so the caller proceeds on herdr rather than treating a broken
    helper as evidence of death.
    """
    try:
        proc = subprocess.run(["behold", "roster", "--summary", "--lane", lane],
                              capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if proc.returncode == 0:
        return True
    if proc.returncode == 5:
        return False
    return None


def pane_exists(pane: str) -> bool:
    panes = (herdr("pane", "list").get("result") or {}).get("panes") or []
    return any(p.get("pane_id") == pane for p in panes)


def resume(lane: str, st: dict, dry: bool) -> int:
    pane = st.get("pane") or ""
    sid = st.get("session_id") or ""
    cwd = st.get("cwd") or os.path.expanduser("~")
    # Role from the state, else from the lane's own record: never a bare default. `pil --role` is
    # what decides whether a resumed lane is a worker or a leader, and a wrong word here silently
    # promotes it (the 2026-11-13 `ft55-parameter-plan` defect, in a different shape).
    role = st.get("role") or role_of(lane) or "leader"
    if not sid:
        out(f"{lane}: DOWN with no recorded session id — needs a human to start it once")
        st["needs_human"] = True
        st["last_attempt_epoch"] = time.time()
        st["attempts"] = int(st.get("attempts") or 0) + 1
        if not dry:
            write_json(state_path(lane), st)
        return 1
    now = time.time()
    wait = min(BACKOFF_CAP, BACKOFF_BASE * (2 ** max(0, int(st.get("attempts") or 0))))
    tried = float(st.get("last_attempt_epoch") or 0)
    if st.get("attempts") and now - tried < wait:
        out(f"{lane}: DOWN, backing off {int(wait - (now - tried))}s (attempt {st.get('attempts')})")
        return 1
    if not pane:
        out(f"{lane}: DOWN with no known pane — needs a human (start it once while supervision runs)")
        return 1
    # The pane is a shared surface: a tab that was closed and reopened for another lane, or a lane
    # that was replaced in place, would receive this command in ITS composer. Both checks are about
    # the irreversible action only, so a normal pass pays nothing for them.
    if pi_pid(pane):
        out(f"{lane}: NOT resuming — pane {pane} already holds a live pi; typing there would land in "
            f"another lane's composer")
        return 1
    if not pane_exists(pane):
        out(f"{lane}: pane {pane} no longer exists — start it once with spawn-lane or relaunch-lane.sh")
        st["needs_human"] = True
        if not dry:
            write_json(state_path(lane), st)
        return 1

    # Second, independent confirmation before creating a second writer. herdr can report a lane
    # down while it is merely between states, and a wrong resume here means two processes on one
    # session. behold reads the same topology but publishes an explicit negative: exit 5 with
    # `lane-not-found`. Only the irreversible path pays for this; the normal pass stays on herdr.
    confirm = behold_still_sees(lane)
    if confirm is True:
        out(f"{lane}: herdr reports it down but behold still lists it — NOT resuming "
            f"(healers disagree; a second writer is worse than a late resume)")
        return 1
    if confirm is None:
        out(f"{lane}: behold unavailable for confirmation; proceeding on the herdr reading")

    cmd = f"cd {shquote(cwd)} && pil --role {role} --session {shquote(sid)}"
    if dry:
        out(f"{lane}: would run in {pane}: {cmd}")
        return 0
    out(f"{lane}: DOWN — resuming session {sid} in {pane}  [{down_evidence(pane, lane)}]")
    herdr("pane", "run", pane, cmd)
    pid = None
    for _ in range(20):
        time.sleep(3)
        pid = pi_pid(pane)
        if pid:
            break
    st["last_attempt_epoch"] = now
    if pid:
        # A started process is not a recovered lane. Clearing the counter here is what let a crash
        # loop resume every 60s forever, each resume reloading the whole session. It clears only
        # after the lane has STAYED up (FLAP_WINDOW, in the alive path of the pass).
        st["attempts"] = int(st.get("attempts") or 0) + 1
        st["last_resume_epoch"] = now
        if st["attempts"] >= FLAP_HUMAN_AT:
            st["needs_human"] = True
            out(f"{lane}: resumed, pid={pid} — FLAP {st['attempts']}: dying repeatedly, flagged for a human")
        else:
            out(f"{lane}: resumed, pid={pid}")
        write_json(state_path(lane), refresh(lane, st, agent(lane)))
        if not notify(lane):
            # The lane is up but may not know it. Exit non-zero so the unit shows it rather than
            # leaving the discovery to the operator, who is the one who noticed both times.
            return 1
        return 0
    st["attempts"] = int(st.get("attempts") or 0) + 1
    write_json(state_path(lane), st)
    out(f"{lane}: resume failed (attempt {st['attempts']})")
    return 1


def hold_state() -> tuple[bool, str]:
    """True when a helper asked supervision to stand down (keepalive-hold).

    A helper that stops a lane to replace it must not have this timer resume it mid-operation: that
    is two processes racing one session, which is the failure the "never resume over a live lane"
    rule exists to prevent. The hold carries its owner pid so a crashed helper cannot pause
    supervision forever, and both pause and auto-release are logged rather than silent.
    """
    path = os.path.join(SUPERVISE, "_hold")
    try:
        with open(path, encoding="utf-8") as fh:
            raw = fh.read().strip()
    except OSError:
        return False, "no hold"
    if raw in ("", "0", "null", "{}"):
        return False, "no hold"
    try:
        rec = json.loads(raw)
    except json.JSONDecodeError:
        try:
            rec = {"since": float(raw)}
        except ValueError:
            return False, f"malformed hold ({raw[:40]!r}) — treating as released"
    if not isinstance(rec, dict):
        rec = {"since": 0.0}
    since = float(rec.get("since") or 0)
    age = max(0.0, time.time() - since) if since else 0.0
    owner = rec.get("pid")
    ttl = float(os.environ.get("KEEPALIVE_HOLD_TTL", "1800"))
    if owner:
        try:
            os.kill(int(owner), 0)
            alive = True
        except OSError:
            alive = False
        if alive:
            return True, f"held by pid {owner} for {int(age)}s ({rec.get('reason') or 'no reason given'})"
        return False, f"owner pid {owner} is gone — hold auto-released ({rec.get('reason') or 'no reason'})"
    if since and age > ttl:
        return False, f"ownerless hold expired after {int(age)}s (ttl {int(ttl)}s)"
    return True, f"ownerless hold, {int(age)}s of {int(ttl)}s ({rec.get('reason') or 'no reason given'})"


def hold_lane() -> str:
    """The lane a hold names, or "" — re-read per lane, because a helper moves through targets."""
    path = os.path.join(SUPERVISE, "_hold")
    try:
        with open(path, encoding="utf-8") as fh:
            rec = json.loads(fh.read().strip() or "{}")
    except (OSError, json.JSONDecodeError):
        return ""
    if not isinstance(rec, dict):
        return ""
    return rec.get("lane") or ""


def one_pass(only: str | None, dry: bool) -> int:
    held, why = hold_state()
    if held and not hold_lane():
        out(f"skip: supervision paused — {why}")
        return 0
    lanes, _ = discovery()
    if only:
        lanes = {only: "restricted by --only"}
    if not lanes:
        out("nothing to supervise (no leader role records and no explicit adds)")
        return 0
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            out("skip: another pass holds the lock")
            return 0
        rc = 0
        skipped_for_hold: list[str] = []
        for lane in sorted(lanes):
            # A helper may be mid-replacement of one lane right now. Skip exactly that lane and
            # keep supervising the rest: a hold naming a lane is a precise window, not a global
            # outage, and skipping everything would delay a real death elsewhere for no reason.
            held_now, why_now = hold_state()
            named = hold_lane() if held_now else ""
            if held_now and named and named == lane:
                skipped_for_hold.append(lane)
                continue
            st = read_json(state_path(lane), {}) or {}
            pane = st.get("pane") or ""
            pid = pi_pid(pane)
            held_by = occupant(pane) if pid else ""
            if pid and held_by and held_by != lane:
                # Someone else's lane is in the pane this lane used to own. Resuming here would
                # type a `pil` command into a live agent's composer, and refreshing state from it
                # would record a wrong pane for a later resume. Say it and touch nothing.
                out(f"{lane}: pane {pane} is now {held_by}'s — not resuming there, and not "
                    f"touching it (point the lane at another pane or start it once by hand)")
                if not dry:
                    st = dict(st, needs_human=True)
                    write_json(state_path(lane), st)
                rc = max(rc, 1)
                continue
            if pid:
                # The lane has stayed up, so forgive earlier flaps -- but only after FLAP_WINDOW,
                # so a lane that dies again in a minute keeps its growing backoff.
                resumed_epoch = float(st.get("last_resume_epoch") or 0)
                if st.get("attempts") and time.time() - resumed_epoch >= FLAP_WINDOW:
                    st = dict(st, attempts=0)
                    st.pop("needs_human", None)
                    st["recovered_epoch"] = time.time()
                rec = agent(lane)
                new = refresh(lane, st, rec)
                if new != st and not dry:
                    write_json(state_path(lane), new)
                elif new != st:
                    out(f"{lane}: would refresh state (pane {new.get('pane')}, session {new.get('session_id')})")
                continue
            # Not in its recorded pane. If it moved panes, herdr still knows it by name.
            rec = agent(lane)
            if rec:
                new = refresh(lane, st, rec)
                if new != st and not dry:
                    write_json(state_path(lane), new)
                continue
            # Down with nothing to resume and no pane to put it in: it cannot come back without a
            # human, so drop the observation instead of reporting it every minute forever.
            if not (st.get("session_id") or st.get("pane")):
                out(f"{lane}: dropped — not live, no pane and no session id recorded")
                if not dry:
                    try:
                        os.unlink(state_path(lane))
                    except OSError:
                        pass
                continue
            rc = max(rc, resume(lane, st, dry))
        if skipped_for_hold:
            out(f"held by a helper, skipped: {', '.join(skipped_for_hold)}")
        return rc


def cmd_list(as_json: bool, show_uncovered: bool = False) -> int:
    lanes, excluded = discovery()
    rows = []
    for lane, reason in sorted(lanes.items()):
        st = read_json(state_path(lane), {}) or {}
        pane = st.get("pane") or ""
        alive = bool(pi_pid(pane)) or bool(agent(lane))
        rows.append({
            "lane": lane, "reason": reason, "pane": pane or None,
            "alive": alive, "session_id": st.get("session_id") or None,
            "attempts": st.get("attempts", 0), "needs_human": bool(st.get("needs_human")),
            "cwd": st.get("cwd") or None,
        })
    outside = uncovered(lanes, excluded)
    live_outside = [r for r in outside if r["alive"]]
    inactive_outside = [r for r in outside if not r["alive"]]
    if as_json:
        payload = {
            "supervised": rows,
            "excluded": sorted(excluded),
            "uncovered_live": live_outside,
            "uncovered_inactive": len(inactive_outside),
        }
        if show_uncovered:
            payload["uncovered"] = outside
        print(json.dumps(payload, indent=1))
        return 0
    if not rows:
        print("no lanes supervised")
    for r in rows:
        print(f"{r['lane']:28} {str(r['pane'] or '-'):9} {'live' if r['alive'] else 'DOWN':5} "
              f"{r['reason']:22} session={r['session_id'] or '<none>'}"
              + (" NEEDS-HUMAN" if r["needs_human"] else ""))
    if excluded:
        print(f"excluded (never touched): {', '.join(sorted(excluded))}")
    # The lanes this pass will NOT bring back. Printed because an unprinted absence reads as
    # coverage: the operator's question in FT-78 was "does the supervisor restart anything?",
    # asked after a worker named `experiment` was Ctrl-C'd and silently never came back.
    if live_outside:
        print(f"not supervised, live now ({len(live_outside)}):")
        for r in live_outside:
            print(f"  {r['lane']:26} {str(r['mode'] or '-'):7} {str(r['pane'] or '-'):9} {r['reason']}")
    if inactive_outside:
        print(f"not supervised, not live: {len(inactive_outside)} role record(s)"
              + ("" if show_uncovered else
                 " — a retired lane is not an outage; --list --uncovered to list them"))
    if show_uncovered:
        for r in inactive_outside:
            print(f"  {r['lane']:26} {str(r['mode'] or '-'):7} {str(r['pane'] or '-'):9} "
                  f"session={r['session_id'] or '<none>'}  {r['reason']}")
    return 0


def edit_set(path: str, lane: str, add: bool) -> int:
    data = read_json(path, [])
    items = set(data if isinstance(data, list) else [])
    if add:
        items.add(lane)
    else:
        items.discard(lane)
    write_json(path, sorted(items))
    return 0


def cmd_add(lane: str) -> int:
    """Add a lane, and make the add survive the lane already being down.

    `--add` alone is not enough to bring a lane back: a resume needs pane, session id and role, and
    the supervisor writes those only while it is already watching the lane. Adding one that died
    minutes ago (the FT-78 case: Ctrl-C on a worker, then "why did it never come back") left
    discovery with nothing to act on. The lane's own record knows all three, so seed from it.
    """
    rc = edit_set(EXTRA_FILE, lane, True)
    seeded = seed_state(lane)
    if seeded:
        out(f"{lane}: added; seeded pane={seeded.get('pane')} session={seeded.get('session_id')} "
            f"role={seeded.get('role')} from {seeded.get('seeded_from')}")
    else:
        out(f"{lane}: added; no newer record than the state it already had — a pass will resume it "
            f"if it is down and has a pane, or report what it needs")
    return rc


def cmd_remove(lane: str) -> int:
    """Drop an add AND the persisted observation.

    Discovery includes any lane that has a state file, so forgetting the observation matters: an
    `--add` followed by `--remove` used to leave the lane discovered forever as "observed earlier".
    """
    rc = edit_set(EXTRA_FILE, lane, False)
    try:
        os.unlink(state_path(lane))
        out(f"{lane}: removed (with its persisted pane/session state)")
    except OSError:
        out(f"{lane}: removed (it had no persisted state)")
    return rc


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="lane-supervise",
        description="Keep leader lanes up: resume any leader whose process disappeared.",
        epilog="Discovery is by role record (~/.local/state/pil/roles/<lane>.env, PI_MODE=leader), so a "
               "new space's leader is covered without editing any unit, and a lane is discoverable "
               "while it is down. WORKER LANES ARE NOT SUPERVISED unless added with --add: they are "
               "retired when their item is done, so resuming all of them would resurrect finished "
               "work. --list names the lanes it does not cover. Holds go in --exclude.",
    )
    ap.add_argument("--add", metavar="LANE", help="also supervise this non-leader lane")
    ap.add_argument("--remove", metavar="LANE", help="drop an --add")
    ap.add_argument("--exclude", metavar="LANE", help="never supervise this lane")
    ap.add_argument("--unexclude", metavar="LANE")
    ap.add_argument("--list", action="store_true", help="show discovered lanes and their state")
    ap.add_argument("--uncovered", action="store_true",
                    help="with --list: also list every role record this pass will not resume")
    ap.add_argument("--only", metavar="LANE", help="restrict a pass to one lane")
    ap.add_argument("--dry-run", action="store_true", help="report, never launch or write")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    if args.add:
        return cmd_add(args.add)
    if args.remove:
        return cmd_remove(args.remove)
    if args.exclude:
        return edit_set(EXCLUDE_FILE, args.exclude, True)
    if args.unexclude:
        return edit_set(EXCLUDE_FILE, args.unexclude, False)
    if args.list:
        return cmd_list(args.json, args.uncovered)
    return one_pass(args.only, args.dry_run)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
