#!/usr/bin/env python3
"""lane-supervise — resume lanes that should always be up, after their process disappears.

What already exists, and why this file does not replace it
---------------------------------------------------------
`overlord-watchdog.sh` + `overlord-watchdog.timer` (OnCalendar every minute) do exactly this for
ONE lane, the overlord on `wE:p1`. Its design notes are the source of the invariants below, and
they were learned the hard way:

  * never resume over a live lane — a resumed lane that was merely slow means two writers on one
    session, which is a second outage, not a fix;
  * resume, never start fresh — the coordination state lives in the session, so a blank session is
    an outage with a healthy pid;
  * record the session UUID, not the path — pi-profile-switch creates a new instance dir per launch
    and sweeps old ones, so a recorded path can be gone by the next pass;
  * only overwrite a recorded target with one whose file exists.

What it does not do is cover any other lane, which is why a self-improvement-leader process that
exited on 2026-11-14 sat dead until the operator noticed and told the overlord.

This tool keeps every one of those invariants and generalises the *registry*, not the policy:
lanes are supervised only when explicitly added, so nothing is resurrected because a human closed
it on purpose. Default state is empty — no lane changes behaviour until one is added.

Usage
-----
  lane-supervise --add <lane> [--role leader|worker] [--dry-run]
  lane-supervise --remove <lane>
  lane-supervise --list [--json]
  lane-supervise [--dry-run] [--only <lane>]     one pass over the registry

Options
-------
  --dry-run     report what would happen; never launch, never write a marker
  --only LANE   restrict a pass to one lane
  --json        machine-readable output
  --help        this text

Safety
------
  * a lane with a live pi process in its pane is left alone, and its recorded session is refreshed
  * a lane with no recorded session id is NOT started fresh; it is reported for a human
  * a lane whose recorded session file has vanished is reported, not resumed (nothing to resume)
  * the pass takes the same flock as the watchdog (`watchdog.lock`), so the two can never resume
    the same lane concurrently
  * backoff: after a failed resume the lane is not retried for 60s * 2^attempts, capped at 30 min,
    so a bundle that cannot start does not become a restart loop
  * the resumed lane is told it was resumed by a machine and when, because a lane that silently
    continues cannot tell which of its own memories have a gap

Exit codes: 0 nothing needed doing or everything resumed · 1 something failed or needs a human ·
2 refusal before reading anything.
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time

STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "pil")
REGISTRY = os.path.join(STATE, "supervise")
ROLES = os.path.join(STATE, "roles")
LOCK = os.path.join(os.path.dirname(STATE), "overlord", "watchdog.lock")
BACKOFF_BASE = 60.0
BACKOFF_CAP = 1800.0


def out(msg: str) -> None:
    print(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}")


def die(msg: str, code: int = 2) -> "None":
    print(f"lane-supervise: {msg}", file=sys.stderr)
    raise SystemExit(code)


def herdr(*args: str) -> dict:
    try:
        proc = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    if proc.returncode != 0:
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


def agent(lane: str) -> dict:
    return (herdr("agent", "get", lane).get("result") or {}).get("agent") or {}


def session_of(rec: dict) -> str | None:
    sess = rec.get("agent_session") or {}
    path = sess.get("value") if isinstance(sess, dict) else None
    return path if path and os.path.exists(path) else None


def session_id(path: str) -> str:
    base = os.path.basename(path)
    if "_" in base:
        base = base.split("_", 1)[1]
    return base[:-6] if base.endswith(".jsonl") else ""


def pi_pid(pane: str) -> str | None:
    procs = ((herdr("pane", "process-info", "--pane", pane).get("result") or {})
             .get("process_info") or {}).get("foreground_processes") or []
    for proc in procs:
        if (proc.get("name") or "") == "pi" or (proc.get("argv") or [None])[0] == "pi":
            return str(proc.get("pid") or "")
    return None


def role_of(lane: str) -> str:
    path = os.path.join(ROLES, f"{lane}.env")
    try:
        with open(path, encoding="utf-8") as fh:
            for token in fh.read().split():
                if token.startswith("PI_MODE="):
                    return token.split("=", 1)[1]
    except OSError:
        pass
    return "leader"


def marker_path(lane: str) -> str:
    return os.path.join(REGISTRY, f"{lane}.json")


def load_marker(lane: str) -> dict:
    try:
        with open(marker_path(lane), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}


def save_marker(lane: str, data: dict) -> None:
    os.makedirs(REGISTRY, exist_ok=True)
    tmp = marker_path(lane) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, marker_path(lane))


def all_markers() -> list[str]:
    try:
        return sorted(n[:-5] for n in os.listdir(REGISTRY) if n.endswith(".json"))
    except OSError:
        return []


def cmd_add(lane: str, role: str | None, dry: bool) -> int:
    rec = agent(lane)
    if not rec:
        die(f"no live agent named {lane} — start it once, then add it")
    pane = rec.get("pane_id")
    cwd = rec.get("cwd") or ""
    sess = session_of(rec)
    data = {
        "lane": lane,
        "pane": pane,
        "cwd": cwd,
        "role": role or role_of(lane),
        "session_id": session_id(sess) if sess else "",
        "session_path": sess or "",
        "added_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "attempts": 0,
    }
    if dry:
        print(json.dumps(data, indent=1))
        return 0
    save_marker(lane, data)
    print(f"supervising {lane} on {pane} role={data['role']} "
          f"session={data['session_id'] or '<none yet>'}")
    if not sess:
        print(f"  note: {lane} has no session file yet; a resume target appears after its first turn")
    return 0


def cmd_remove(lane: str) -> int:
    try:
        os.unlink(marker_path(lane))
    except FileNotFoundError:
        print(f"{lane} was not supervised")
        return 0
    print(f"no longer supervising {lane}")
    return 0


def cmd_list(as_json: bool) -> int:
    lanes = all_markers()
    if as_json:
        print(json.dumps([load_marker(l) for l in lanes], indent=1))
        return 0
    if not lanes:
        print("no lanes supervised (the overlord is covered by overlord-watchdog.timer regardless)")
        return 0
    for lane in lanes:
        m = load_marker(lane)
        alive = "live" if pi_pid(m.get("pane") or "") else "DOWN"
        print(f"{lane:26} {str(m.get('pane')):9} {m.get('role'):7} {alive:5} "
              f"session={m.get('session_id') or '<none>'} attempts={m.get('attempts', 0)}")
    return 0


def resume(lane: str, m: dict, dry: bool) -> int:
    pane = m.get("pane") or ""
    sid = m.get("session_id") or ""
    cwd = m.get("cwd") or os.path.expanduser("~")
    role = m.get("role") or "leader"
    if not pane:
        out(f"{lane}: marker has no pane — remove and re-add")
        return 1
    if not sid:
        out(f"{lane}: DOWN with no recorded session id — a human must start it once")
        return 1
    given = time.time()
    wait = min(BACKOFF_CAP, BACKOFF_BASE * (2 ** max(0, int(m.get("attempts") or 0))))
    tried = float(m.get("last_attempt_epoch") or 0)
    if m.get("attempts") and given - tried < wait:
        out(f"{lane}: DOWN, backing off another {int(wait - (given - tried))}s "
            f"(attempt {m.get('attempts')})")
        return 1
    cmd = f"cd {shquote(cwd)} && pil --role {role} --session {shquote(sid)}"
    if dry:
        out(f"{lane}: would run in {pane}: {cmd}")
        return 0
    out(f"{lane}: DOWN — resuming session {sid} in {pane}")
    herdr("pane", "run", pane, cmd)
    pid = None
    for _ in range(20):
        time.sleep(3)
        pid = pi_pid(pane)
        if pid:
            break
    m["last_attempt_epoch"] = given
    if pid:
        m["attempts"] = 0
        sess = session_of(agent(lane))
        if sess:
            m["session_id"] = session_id(sess)
            m["session_path"] = sess
        save_marker(lane, m)
        out(f"{lane}: resumed, pid={pid}")
        notify(lane, pane)
        return 0
    m["attempts"] = int(m.get("attempts") or 0) + 1
    save_marker(lane, m)
    out(f"{lane}: resume did not bring it back (attempt {m['attempts']})")
    return 1


def notify(lane: str, pane: str) -> None:
    """Tell the lane it was resumed by a machine. Best effort, never blocking, never a second turn."""
    msg = (f"[lane-supervise — automated resume, NOT from the operator] This lane was found down and "
           f"resumed into its previous session at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}. "
           f"Nothing was restarted; whatever was in flight is still in this session. Check the gap.")
    rec = agent(lane)
    if rec.get("agent_status") in ("working", "blocked"):
        out(f"{lane}: resumed but is {rec.get('agent_status')} — not interrupting for the notice")
        return
    proc = subprocess.run(["herdr", "agent", "prompt", lane, msg, "--wait", "--timeout", "30000"],
                          capture_output=True, text=True)
    if proc.returncode == 0:
        out(f"{lane}: notified of the resume")
    else:
        out(f"{lane}: notice not delivered ({(proc.stderr or proc.stdout).strip()[:120]})")


def shquote(text: str) -> str:
    return "'" + text.replace("'", "'\\''") + "'"


def one_pass(only: str | None, dry: bool) -> int:
    lanes = [only] if only else all_markers()
    if not lanes:
        return 0
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            out("skip: another pass holds the lock (watchdog or a previous run)")
            return 0
        rc = 0
        for lane in lanes:
            m = load_marker(lane)
            if not m:
                out(f"{lane}: no marker — skipping")
                continue
            pane = m.get("pane") or ""
            if pi_pid(pane):
                # Live. Refresh the resume target if the session has produced a file.
                sess = session_of(agent(lane))
                if sess and session_id(sess) != m.get("session_id"):
                    m["session_id"] = session_id(sess)
                    m["session_path"] = sess
                    m["attempts"] = 0
                    if not dry:
                        save_marker(lane, m)
                    out(f"{lane}: live, resume target updated to {m['session_id']}")
                continue
            rc = max(rc, resume(lane, m, dry))
        return rc


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="lane-supervise",
        description="Resume lanes that should always be up, after their process disappears.",
        epilog="Opt-in by design: only lanes added with --add are supervised. The overlord lane is "
               "already covered by overlord-watchdog.timer and is not managed here.",
    )
    ap.add_argument("--add", metavar="LANE", help="supervise this lane from now on")
    ap.add_argument("--remove", metavar="LANE", help="stop supervising this lane")
    ap.add_argument("--list", action="store_true", help="show the registry")
    ap.add_argument("--only", metavar="LANE", help="restrict a pass to one lane")
    ap.add_argument("--role", choices=("leader", "worker"), help="role to relaunch with (default: from the role record)")
    ap.add_argument("--dry-run", action="store_true", help="report, never launch or write")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    if args.add:
        return cmd_add(args.add, args.role, args.dry_run)
    if args.remove:
        return cmd_remove(args.remove)
    if args.list:
        return cmd_list(args.json)
    return one_pass(args.only, args.dry_run)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
