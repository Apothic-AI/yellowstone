#!/usr/bin/env bash
# beady-eye-config — regenerate ~/.config/beady-eye/config.toml
#
# bdi (beady-eye) needs a [[projects]] block per *tracker*. Without a config it
# falls back to inferring the project from the cwd, so a pane opened in a
# non-project directory (e.g. ~/.pi) fails with:
#   "there is no config at ~/.config/beady-eye/config.toml, so bdi read the
#    current directory ... is not inside a beads project"
#
# ONE DATABASE, ONE PROJECT. Every workspace on this machine is attached to the
# same master tracker (`swarm` on Dolt at 127.0.0.1:3307) via a `.beads/metadata.json`
# that `bd` finds by walking up from the cwd, so each such file carries the same
# dolt_database and project_id. (BEADS_DIR is NOT set in a live lane — checked in
# /proc; the env-var form is migration-plan intent, not runtime behaviour.) bdi
# partitions the fleet by *configured project* and refuses a bead whose
# agent_pane resolves to a different one, so emitting a block per checkout
# turned the one shared database into N projects and reported every cross-space
# claim as `pane-in-another-project` (8 of them, 2026-11-02).
#
# So group by tracker identity, not by checkout: one block per distinct
# (dolt_database, project_id), emitted at the shallowest path in the group —
# the one whose cwd covers every lane's pane. A path with no metadata.json (a
# standalone rig) keeps its own block.
#
# A directory counts only when `bd where` resolves there: a stray `.beads/`
# holding just global metadata (machine-id, eventsData) is not a workspace.
#
# Re-run this as spaces are initialized. bdi re-reads the config while running,
# so no restart is needed.

set -uo pipefail

CONFIG="${BEADY_EYE_CONFIG:-$HOME/.config/beady-eye/config.toml}"
BD="${BD_BIN:-bd}"
ROOTS=("$HOME")

find_workspaces() {
  local f
  # .beads can be at a repo root or nested; depth 5 covers ~/Code/<repo>/<sub>.
  while IFS= read -r f; do
    printf '%s\n' "${f%/.beads}"
  done < <(find "${ROOTS[@]}" -maxdepth 5 -name .beads -type d \
             -not -path "*/node_modules/*" 2>/dev/null | sort)
}

resolves() {
  ( cd "$1" 2>/dev/null && timeout 10 "$BD" where >/dev/null 2>&1 )
}

slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\+/-/g' -e 's/^-//' -e 's/-$//'
}

# tracker_key <path> — identity of the tracker a workspace is attached to.
# Prints "<database>:<project_id>" when .beads/metadata.json names one, and
# "path:<path>" for a standalone rig that has no shared tracker.
tracker_key() {
  local p="$1" db pid
  if [ -f "$p/.beads/metadata.json" ]; then
    db="$(sed -n 's/.*"dolt_database"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$p/.beads/metadata.json" 2>/dev/null | head -n 1)"
    pid="$(sed -n 's/.*"project_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$p/.beads/metadata.json" 2>/dev/null | head -n 1)"
    if [ -n "$db" ] && [ -n "$pid" ]; then
      printf 'tracker:%s:%s\n' "$db" "$pid"
      return 0
    fi
  fi
  printf 'path:%s\n' "$p"
}

main() {
  declare -A group_path=() group_name=() used=()
  local p key base slug

  while IFS= read -r p; do
    resolves "$p" || continue
    key="$(tracker_key "$p")"

    if [ -z "${group_path[$key]:-}" ]; then
      group_path[$key]="$p"
      case "$key" in
        tracker:*)
          # The tracker's own name is the honest project name: one database,
          # one project. Fall back to the directory if it slugifies to nothing.
          base="${key#tracker:}"; base="${base%%:*}"
          slug="$(slugify "$base")"
          [ -n "$slug" ] || slug="$(slugify "$(basename "$p")")"
          ;;
        *)
          # Standalone rig: prefer its beads prefix, else the directory name.
          base="$(sed -n 's/^prefix:[[:space:]]*\([A-Za-z0-9_-]*\).*/\1/p' \
                    "$p/.beads/config.yaml" 2>/dev/null | head -n 1)"
          [ -n "$base" ] || base="$(basename "$p")"
          slug="$(slugify "$base")"
          ;;
      esac
      [ -n "$slug" ] || slug="project"
      group_name[$key]="$slug"
    else
      # Same tracker: keep the shallowest path, which covers the most panes.
      if [ "${#p}" -lt "${#group_path[$key]}" ]; then
        group_path[$key]="$p"
      fi
    fi
  done < <(find_workspaces)

  # de-duplicate names so each project stays addressable
  local n found
  for key in "${!group_name[@]}"; do
    slug="${group_name[$key]}"; n=2; found="$slug"
    while [ -n "${used[$found]:-}" ]; do
      found="$slug-$n"; n=$((n + 1))
    done
    used[$found]=1
    group_name[$key]="$found"
  done

  mkdir -p "$(dirname "$CONFIG")"
  {
    printf '# beady-eye / bdi — generated by %s at %s\n' \
      "beady-eye-config" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '# One [[projects]] block per tracker, not per checkout: every workspace\n'
    printf '# here is attached to the same master Dolt database, so a block each\n'
    printf '# would partition one project into N and conflict every cross-space\n'
    printf '# agent_pane claim. Hand edits are overwritten; re-run this instead.\n'
    printf '# bdi re-reads while running.\n'
    printf '\n'
    if [ "${#group_path[@]}" -eq 0 ]; then
      printf '# (no beads workspaces found — run `bd init` in a project first)\n'
    else
      for key in $(printf '%s\n' "${!group_name[@]}" | sort); do
        printf '[[projects]]\nname = "%s"\npath = "%s"\n\n' \
          "${group_name[$key]}" "${group_path[$key]}"
      done
    fi
  } > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"

  printf 'beady-eye: %d tracker(s) -> %s\n' "${#group_path[@]}" "$CONFIG"
  for key in $(printf '%s\n' "${!group_name[@]}" | sort); do
    printf '  %-20s %s\n' "${group_name[$key]}" "${group_path[$key]/#$HOME/~}"
  done
}

main "$@"