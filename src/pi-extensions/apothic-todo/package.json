{
	"name": "@arhen/pi-core-todo",
	"version": "1.0.14",
	"type": "module",
	"description": "Flat or arbitrarily nested Pi todos with explicit statuses, direct-child progress, dependencies, a compact widget, and a scrollable tree browser.",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"license": "MIT",
	"author": "arhen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Apothic-AI/apothic-todo.git"
	},
	"main": "./src/index.ts",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"todo"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"homepage": "https://github.com/Apothic-AI/apothic-todo#readme",
	"bugs": {
		"url": "https://github.com/Apothic-AI/apothic-todo/issues"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@earendil-works/pi-agent-core": "^1.0.1",
		"@earendil-works/pi-ai": "^1.0.1",
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@earendil-works/pi-tui": "^1.0.1",
		"@types/bun": "^1.3.14",
		"typebox": "^1.3.27",
		"typescript": "^7.0.2"
	}
}
