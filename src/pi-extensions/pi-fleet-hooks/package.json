{
  "name": "pi-fleet-hooks",
  "version": "0.1.0",
  "private": true,
  "description": "Fleet-invariant hooks for Pi: never-block enforcement, transient-error retry recovery, and durable recovery of model-emitted reasoning markup.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apothic-AI/pi-fleet-hooks.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hooks"
  ],
  "pi": {
    "extensions": [
      "./src/nonblock.ts",
      "./src/transient-error-retry.ts",
      "./src/reasoning-recovery.ts",
      "./src/tool-markup-inert.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:reasoning": "node --test test/reasoning-tags.test.ts test/reasoning-replay.test.ts test/chat-completions-payload.test.ts test/persist-replay.test.ts",
    "typecheck": "tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --allowImportingTsExtensions src/reasoning-tags.ts src/reasoning-replay.ts src/inert-tool-markup.ts src/tool-markup-inert.ts",
    "test:session": "node --test test/session-integration.test.ts",
    "test:inert": "node --test test/tool-markup-inert.test.ts test/tool-markup-render.test.ts"
  }
}
